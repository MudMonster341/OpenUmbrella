    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/guards/doc_freshness.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/guards/doc_freshness.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/guards/context_size.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
