# Copy this file to .env and fill in only the keys you have. .env is gitignored.
# All are optional: tools/freellm works with no keys at all (OVHcloud and LLM7.io).
# Create each key yourself on the provider's site. Never commit a real key.

# Groq - https://console.groq.com/keys  (30 requests/minute, 1,000/day on the free plan)
GROQ_API_KEY=

# OpenRouter - https://openrouter.ai/keys  (50 requests/day on free models; may log prompts)
OPENROUTER_API_KEY=

# Google Gemini - https://aistudio.google.com/apikey  (free-tier prompts may be used by Google)
GEMINI_API_KEY=
